#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    local app_dir="@APP_DIR@"
    procd_open_instance
    procd_set_param command /usr/bin/python3 -u "$app_dir/main.py" --config-dir "$app_dir"
    procd_set_param env PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
    procd_set_param dir "$app_dir"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
